# ============================================================
# 符文档案 · 周报 —— Supabase 连接配置(模板)
#
# 复制本文件为 .env.local 并填入真实值:
#   cp .env.example .env.local
#
# 用途:仅「云端内容」与「编辑部」栏目需要。缺失时:
#   - 云端内容工具显示「未配置」(不是错误,见 src/tools/state.ts)
#   - 编辑部显示配置说明页
# 期刊与本地分析工具完全不依赖本文件,离线照常可用。
#
# .env / .env.local 已被 .gitignore 忽略,不会提交到仓库。
# ============================================================

# Supabase 项目 URL(Dashboard → Settings → API → Project URL)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# anon / publishable key(Dashboard → Settings → API → anon public)
# 只用公开 key;service_role 绝不出现在浏览器端。
VITE_SUPABASE_ANON_KEY=your-anon-public-key
