{
  "name": "riftbound-meta-analytics",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Riftbound (符文战场) TCG 赛事 Meta 分析系统 —— Vite + Vue 3 + TypeScript 重构版",
  "scripts": {
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "build:fast": "vite build",
    "dev": "vite",
    "preview": "vite preview",
    "smoke": "node --experimental-strip-types --import ./scripts/register-hooks.mjs smoke.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && tsc -p functions/tsconfig.json",
    "verify:admin-logic": "node scripts/verify-admin-logic.mjs",
    "verify:admin-rules": "node scripts/verify-admin-rules.mjs",
    "verify:admin-snapshot": "node scripts/verify-admin-snapshot.mjs",
    "verify:admin-sync": "node scripts/verify-admin-sync.mjs",
    "verify:all": "npm run type-check && npm run verify:sanitizer && npm run verify:admin-logic && npm run verify:admin-rules && npm run verify:admin-sync && npm run verify:sync-review && npm run verify:qa-sync && npm run verify:carddex-qa && npm run verify:admin-snapshot && npm run verify:chain-ui && npm run verify:editorial",
    "verify:chain-ui": "node scripts/verify-chain-ui.mjs",
    "verify:chain-ui:dev": "CHAIN_APP=http://127.0.0.1:5173/ node scripts/verify-chain-ui.mjs",
    "verify:editorial": "node scripts/verify-editorial.mjs",
    "verify:sanitizer": "node scripts/verify-sanitizer.mjs",
    "wrap:china-map": "node scripts/wrap-china-map.mjs",
    "verify:sync-review": "node --experimental-strip-types --import ./scripts/register-hooks.mjs scripts/verify-sync-review.mjs",
    "verify:qa-sync": "node --experimental-strip-types --import ./scripts/register-hooks.mjs scripts/verify-qa-sync.mjs",
    "verify:carddex-qa": "node --experimental-strip-types --import ./scripts/register-hooks.mjs scripts/verify-carddex-qa.mjs",
    "verify:sync-review-ui": "node scripts/verify-sync-review-ui.mjs",
    "verify:sync-review-perf": "node scripts/verify-sync-review-ui.mjs --perf --assert-fast"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "oboe": "^2.1.7",
    "papaparse": "^5.4.1",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
