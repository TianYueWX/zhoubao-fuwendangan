{
  "name": "riftbound-meta-analytics",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Riftbound (符文战场) TCG 赛事 Meta 分析系统 —— Vite + Vue 3 + TypeScript 重构版",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json && vite build",
    "build:fast": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit -p tsconfig.json && vue-tsc --noEmit -p tsconfig.node.json",
    "smoke": "node --experimental-strip-types --import ./scripts/register-hooks.mjs smoke.ts",
    "wrap:china-map": "node scripts/wrap-china-map.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "oboe": "^2.1.7",
    "papaparse": "^5.4.1",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/papaparse": "^5.3.15",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vue-tsc": "^2.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
